# User ID and Group ID for containers
# These will be automatically set by run.sh, or you can set them manually
UID=1000
GID=1000

# Timezone
TZ=Asia/Shanghai

# Default values
# Set this to the absolute path if you want to use a different location
MIDDLEWARE_HOME=.
#-------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=admin
MYSQL_USER=admin
MYSQL_PASSWORD=admin
LANG=C.UTF-8
# 设置MySQL容器时区为上海
TZ=Asia/Shanghai
#-------------------------------------------
DATA_HOME=./data
BACKEND_IMAGE=spring-ai-admin-server
FRONTEND_IMAGE=spring-ai-admin-frontend
IMAGE_TAG=latest